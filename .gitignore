# ============================================================
# VCStockRank - .gitignore
# Python, PyTorch and quantitative research
# ============================================================

# -------------------- Python --------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# pyenv
.python-version

# pipenv
Pipfile.lock

# poetry
poetry.lock

# -------------------- Virtual environments --------------------
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# -------------------- IDEs and editors --------------------
# PyCharm
.idea/
*.iml
*.iws

# VS Code
.vscode/
*.code-workspace

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# Sublime Text
*.sublime-project
*.sublime-workspace

# -------------------- Operating systems --------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# -------------------- Research data --------------------
# Raw data
data/*.parquet
data/*.csv
!data/.gitkeep

# Factor panels
data/factors_*.csv
data/factors_*.parquet

# Price panels
data/daily*.parquet
data/daily*.csv

# Predictions
runs/
.streamlit/secrets.toml
predictions_*.csv
predictions_*.parquet

# Backtest outputs
backtest_returns.csv
daily_ic.csv
long_short_returns.csv
!reports/**/backtest_returns.csv
!reports/**/daily_ic.csv
!reports/**/long_short_returns.csv

# -------------------- Models --------------------
# PyTorch weights
*.pt
*.pth
*.pkl

# Model checkpoints
logs/
checkpoints/
*.log

# -------------------- Caches --------------------
cache/
__pycache__/

# -------------------- Private configuration --------------------
# Environment variables
.env
.env.local
.env.*.local

# Local secrets
config.local.py
secrets.py
*.secret.py

# API keys
*_key.py
*_keys.py

# -------------------- Intermediate document files --------------------
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz

# -------------------- Other --------------------
# Temporary files
tmp/
temp/
*.tmp

# Archives
*.zip
*.tar.gz
*.rar

# Excel temporary files
~$*.xlsx
~$*.xls

# Large data containers
*.h5
*.hdf5

# Coverage reports
.coverage
htmlcov/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# pytype
.pytype/

# Cython
cython_debug/
